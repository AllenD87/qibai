# ============================================================
# 栖伴 Qibai — CI Secrets / 本地环境变量占位清单（迭代⑥：自动更新）
#
# 本文件仅供清单参考：值一律为空或占位符，绝不写入任何真实密钥。
# 真实值只存放在 CI/CD 的 Secrets（如 GitHub Actions Secrets）中，
# 由构建流水线在打包签名时注入，不进仓库、不进产物。
# ============================================================

# ---------- 更新签名（tauri-plugin-updater） ----------
# 生成密钥对（一次性，仅在你本机执行）：
#   tauri signer generate -w ~/.qibai/update.key
# 公钥（生成输出的 public key）→ 填入 src-tauri/tauri.conf.json 的
#   updater.pubkey（当前为 PASTE_PUBLIC_KEY 占位字符串，上线前替换）。
# 私钥（生成输出的私钥内容）→ 作为 UPDATE_PRIVATE_KEY 存入 CI Secrets，
#   由 tauri build 时自动读取并对安装包签名；绝不写入本仓库。
UPDATE_PRIVATE_KEY=

# ---------- Windows 代码签名（可选，真机打包时按需配置） ----------
# Windows Authenticode 证书（PFX 内容或路径）与密码，按 CI 平台约定命名。
WIN_SIGN=
WIN_SIGN_PASSWORD=

# ---------- macOS 签名 / 公证（可选，真机打包时按需配置） ----------
# Apple Developer ID 证书（Base64 的 p12）、证书密码、公证用 Apple ID
# 凭据（API Key / 或 Apple ID + 应用专用密码）。
APPLE_CERT=
APPLE_CERT_PASSWORD=
APPLE_NOTARY=
APPLE_ID=
APPLE_PASSWORD=
APPLE_TEAM_ID=

# ---------- 运行期应用密钥（占位，与 CI 无关，本地调试用） ----------
# LLM API Key：本地调试可放这里；打包产物内不内置，走系统设置页填写。
DOUBAO_API_KEY=
