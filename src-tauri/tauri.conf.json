{
 "$schema": "https://schema.tauri.app/config/2",
 "productName": "Qibai",
 "version": "0.1.0",
 "identifier": "com.qibai.app",
 "build": {
  "frontendDist": "../src",
  "beforeDevCommand": "",
  "beforeBuildCommand": ""
 },
 "app": {
  "windows": [],
  "security": {
   "csp": "default-src 'self'; img-src 'self' data: asset: https://asset.localhost; media-src 'self' asset: https://asset.localhost; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost",
   "freezePrototype": true,
   "dangerousDisableAssetCspModification": false
  },
  "withGlobalTauri": false
 },
 "bundle": {
  "active": true,
  "targets": "all",
  "icon": [
   "icons/32x32.png",
   "icons/128x128.png",
   "icons/128x128@2x.png"
  ],
  "category": "Entertainment",
  "shortDescription": "AI desktop companion",
  "longDescription": "Qibai (元气小小) — AI desktop companion pet."
 },
 "plugins": {
  "updater": {
   "active": false,
   "endpoints": [
    "https://github.com/<owner>/<repo>/releases/latest/download/latest.json"
   ],
   "pubkey": ""
  }
 }
}